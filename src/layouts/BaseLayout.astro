---
import "@fontsource/dejavu-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Baran Tabak — Yazılım Geliştirici",
  description =
    "Bilgisayar mühendisi Baran Tabak'ın portfolyosu. Go, ASP.NET MVC, React, Next.js ve Astro ile geliştirdiği projeler.",
  image = "/og.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Baran Tabak",
  url: Astro.site?.toString(),
  jobTitle: "Yazılım Geliştirici",
  sameAs: [
    "https://github.com/BaranTab",
    "https://www.linkedin.com/in/baran-tabak-a0481622a/",
  ],
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#2582D0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baran Tabak" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Baran Tabak — Yazılım Geliştirici" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/animations.ts";
    </script>
  </body>
</html>