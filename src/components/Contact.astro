---
const email = "barantabak.dev@gmail.com"; // kendi mailinle değiştir
const links = [
  { label: "github", href: "https://github.com/BaranTab" },
  { label: "linkedin", href: "https://www.linkedin.com/in/baran-tabak-a0481622a/" },
  { label: "cv.pdf ↓", href: "/cv.pdf", download: true },
];
const year = new Date().getFullYear();
---

<section id="iletisim" class="contact">
  <p class="prompt"><b>$</b> ./iletisim --simdi</p>

<h2 data-type>
  Birlikte bir şey<br />
  <a href={`mailto:${email}`} class="dot" data-type-unit aria-label="Bana e-posta gönder">↗</a> üretelim
</h2>

  <ul class="links">
    <li><a href={`mailto:${email}`} class="mail">{email}</a></li>
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          {...(l.download ? { download: true } : { target: "_blank", rel: "noopener" })}
        >
          {l.label}{!l.download && " ↗"}
        </a>
      </li>
    ))}
  </ul>
</section>

<footer class="footer">
  <span>© {year} baran tabak</span>
  <span>özenle ve kahveyle yapıldı</span>
  <a href="#">başa_dön ↑</a>
</footer>

<style>
  /* ================= MASAÜSTÜ ================= */
  .contact {
    padding: 170px var(--pad) 0;
    text-align: center;
  }
  .prompt {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--cloud-dim);
  }
  .prompt b { color: var(--amber); font-weight: 400; }

  h2 {
    --h: 148px; /* başlık boyutu: daire de bu değere göre ölçeklenir */
    margin-top: 26px;
    font-size: var(--h);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--h) * 0.8);
    height: calc(var(--h) * 0.8);
    margin-right: calc(var(--h) * 0.07);
    border-radius: 50%;
    background: var(--amber);
    font-size: calc(var(--h) * 0.27);
    line-height: 1;
    letter-spacing: 0;
    vertical-align: middle;
    position: relative;
    top: calc(var(--h) * -0.07);
    transition: transform 0.3s;
  }
  .dot:hover { transform: rotate(45deg) scale(1.08); }

  .links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 80px;
    border-top: 1px solid var(--cloud);
    list-style: none;
    text-align: left;
  }
  .links li + li {
    padding-left: 24px;
    border-left: 1px solid var(--cloud-line);
  }
  .links a {
    display: block;
    padding: 28px 0;
    font-family: var(--font-mono);
    font-size: 16px;
    transition: color 0.2s;
  }
  .links a:hover { color: var(--amber); }
  .mail {
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    padding: 70px var(--pad) 50px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--cloud-dim);
  }
  .footer a:hover { color: var(--cloud); }

  /* ================= TABLET (900px ve altı) ================= */
  @media (max-width: 900px) {
    .contact { padding-top: 110px; }
    h2 { --h: clamp(44px, 12vw, 148px); }

    .links { grid-template-columns: repeat(2, 1fr); margin-top: 56px; }
    .links li { border-bottom: 1px solid var(--cloud-line); }
    .links li + li { padding-left: 0; border-left: 0; }
    .links li:nth-child(even) {
      padding-left: 20px;
      border-left: 1px solid var(--cloud-line);
    }
  }

  /* ================= TELEFON (640px ve altı) ================= */
  @media (max-width: 640px) {
    .links { grid-template-columns: 1fr; }
    .links li:nth-child(even) { padding-left: 0; border-left: 0; }
    .links a { padding: 20px 0; font-size: 15px; }
    .footer {
      flex-direction: column;
      gap: 10px;
      padding-top: 50px;
    }
  }
</style>