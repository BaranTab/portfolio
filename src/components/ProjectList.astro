---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="projeler" class="projects">
  <header class="head">
    <h2 data-reveal>Geliştirdiğim<br /><span class="outline">projeler</span></h2>
    <p class="cmd">
      <b>$</b> ls ./projeler --öne-çıkanlar<br />
      {pad(projects.length)} kayıt — sıraya göre
    </p>
  </header>

  <div class="labels" aria-hidden="true">
    <span>#</span><span>proje</span><span>teknoloji</span><span>tür</span><span></span>
  </div>

  <ul class="list">
    {projects.map((p, i) => (
      <li data-reveal>
        <a class="row" href={`/projeler/${p.id}`}>
          <span class="no">{pad(i + 1)}</span>
          <h3>{p.data.title}</h3>
          <span class="meta">{p.data.stack.join(" · ")}</span>
          <span class="meta">{p.data.type}</span>
          <span class="arrow">↗</span>
          <span class="preview" aria-hidden="true">
            {p.data.cover && <img src={p.data.cover} alt="" />}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .projects {
    padding: 110px var(--pad) 0;
    overflow-x: clip;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
  }
  h2 {
    font-size: 92px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 0.95;
  }
  .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--cloud);
  }
  .cmd {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.8;
    color: var(--cloud-dim);
    text-align: right;
  }
  .cmd b { color: var(--amber); font-weight: 400; }

  .labels,
  .row {
    display: grid;
    grid-template-columns: 120px 1fr 320px 210px 90px;
    align-items: center;
  }
  .labels {
    padding: 14px 0;
    border-top: 1px solid var(--cloud);
    border-bottom: 1px solid var(--cloud-line);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cloud-dim);
  }

  .list { list-style: none; }
  .row {
    position: relative;
    isolation: isolate;
    padding: 30px 0;
    border-bottom: 1px solid var(--cloud-line);
  }
  .row::before {
    content: "";
    position: absolute;
    inset: 0 -100vmax;
    z-index: -1;
    background: var(--amber);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .no {
    font-size: 46px;
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.2px rgba(243, 246, 249, 0.6);
  }
  h3 {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--cloud-dim);
  }
  .arrow {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border: 1.5px solid var(--cloud-line);
    border-radius: 50%;
    font-size: 18px;
    transition: background 0.25s, color 0.25s;
  }

  .preview {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 280px;
    overflow: hidden;
    border-radius: 120px 120px 8px 8px;
    background: linear-gradient(170deg, #0b2340, #123c6b);
    box-shadow: 0 30px 60px rgba(14, 42, 71, 0.4);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .preview img { width: 100%; height: 100%; object-fit: cover; }

  .row:hover { z-index: 2; border-color: var(--amber); }
  .row:hover::before { opacity: 1; }
  .row:hover .no { -webkit-text-stroke-color: #fff; }
  .row:hover .meta { color: rgba(255, 255, 255, 0.9); }
  .row:hover .arrow { background: var(--cloud); color: var(--amber); border-color: var(--cloud); }
  .row:hover .preview { opacity: 1; }

    @media (max-width: 1100px) {
    .labels,
    .row { grid-template-columns: 90px 1fr 240px 160px 70px; }
    h3 { font-size: 36px; }
  }

  @media (max-width: 760px) {
    .projects { padding-top: 70px; }
    .head { flex-direction: column; align-items: flex-start; gap: 20px; }
    h2 { font-size: clamp(48px, 13vw, 92px); }
    .cmd { text-align: left; }

    .labels { display: none; }
    .list { border-top: 1px solid var(--cloud); }

    .row {
      grid-template-columns: 56px 1fr auto;
      grid-template-areas:
        "no title arrow"
        "no stack arrow"
        "no type  arrow";
      row-gap: 6px;
      padding: 22px 0;
    }
    .no    { grid-area: no; align-self: start; font-size: 32px; }
    h3     { grid-area: title; font-size: 28px; }
    .meta:nth-of-type(2) { grid-area: stack; }
    .meta:nth-of-type(3) { grid-area: type; }
    .arrow { grid-area: arrow; width: 42px; height: 42px; }
  }

  /* Dokunmatik ekranlarda fare olmadığı için önizlemeyi kapat */
  @media (hover: none) {
    .preview { display: none; }
  }


</style>