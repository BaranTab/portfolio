---
// Kendi gerçek rakamlarınla doldur
const stats = [
  { value: "12", suffix: "+", label: "tamamlanan proje" },
  { value: "3", suffix: "ay", label: "endüstriyel OT stajı" },
  { value: "4", suffix: "yıl", label: "bilgisayar mühendisliği" },
  { value: "2", suffix: "", label: "dil: türkçe / ingilizce" },
];
---

<section id="hakkimda" class="stats" aria-label="Kısaca ben">
  {stats.map((s) => (
    <div class="item">
      <p class="value">
        {s.value}
        {s.suffix && <sup>{s.suffix}</sup>}
      </p>
      <p class="label">{s.label}</p>
    </div>
  ))}
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 130px var(--pad) 0;
    border-top: 1px solid var(--cloud-line);
  }
  

    <div class="item" data-reveal>
    <p class="value">
      <span data-count={s.value}>{s.value}</span>
      {s.suffix && <sup>{s.suffix}</sup>}
    </p>
    <p class="label">{s.label}</p>
  </div>

  .item + .item {
    padding-left: 34px;
    border-left: 1px solid var(--cloud-line);
  }
  .value {
    font-size: 104px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  sup {
    margin-left: 4px;
    font-size: 38px;
    color: var(--amber);
    vertical-align: top;
  }
  .label {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cloud-dim);
  }
</style>