---
const stats = [
  { value: "2", suffix: "yıl", label: "ajans dükkanı'nda geliştirme & prodüksiyon" },
  { value: "81", suffix: "il", label: "ajansdukkani.com'un kapsadığı" },
  { value: "3", suffix: "ay", label: "endüstriyel OT stajı" },
  { value: "2", suffix: "", label: "dil: türkçe / ingilizce" },
];
---

<section id="hakkimda" class="stats" aria-label="Kısaca ben">
  {stats.map((s) => (
    <div class="item" data-reveal>
      <p class="value">
        <span data-count={s.value}>{s.value}</span>
        {s.suffix && <sup>{s.suffix}</sup>}
      </p>
      <p class="label">{s.label}</p>
    </div>
  ))}
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 130px var(--pad) 0;
    border-top: 1px solid var(--cloud-line);
  }
  .item { padding-top: 34px; }
  .item + .item {
    padding-left: 34px;
    border-left: 1px solid var(--cloud-line);
  }
  .value {
    font-size: 104px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  sup {
    margin-left: 4px;
    font-size: 38px;
    color: var(--amber);
    vertical-align: top;
  }
  .label {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cloud-dim);
  }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); margin-top: 80px; }
    .item { padding-bottom: 30px; }
    .item + .item { padding-left: 0; border-left: 0; }
    .item:nth-child(even) {
      padding-left: 24px;
      border-left: 1px solid var(--cloud-line);
    }
    .item:nth-child(n + 3) { border-top: 1px solid var(--cloud-line); }
    .value { font-size: clamp(56px, 14vw, 104px); }
    sup { font-size: 0.36em; }
  }
</style>